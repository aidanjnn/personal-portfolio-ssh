# Lives at /opt/portfolio/Caddyfile. The website itself is on Vercel at
# www.aidanjeon.com; this VM only redirects browsers there.
#
# Caddy obtains Let's Encrypt certificates automatically once DNS for these
# names points at the VM, and redirects plain HTTP to HTTPS first.
# Apply edits with: docker compose -f compose.prod.yaml restart caddy

{
	# Nothing reconfigures Caddy at runtime, so the admin API stays off.
	admin off

	# The Azure NSG admits TCP only, so don't advertise HTTP/3 (UDP).
	# A one-hop redirect gains nothing from it.
	servers {
		protocols h1 h2
	}
}

aidanjeon.com, ssh.aidanjeon.com {
	# Vercel answers the apex with exactly this header (2 years, no
	# includeSubDomains, no preload), so browsers already hold it. Send the
	# same so the policy neither lapses nor widens after the move.
	header Strict-Transport-Security "max-age=63072000"
	redir https://www.aidanjeon.com{uri} 308
}
