{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aidanjnn/personal-portfolio-ssh/main/content/portfolio.schema.json",
  "$comment": "Portfolio content contract v2. Produced by the Next.js site at /portfolio.json and consumed by the SSH portfolio. Nullable fields must still be present. The Rust loader additionally limits snapshots to 1 MiB; rejects control (Cc), format (Cf), private-use (Co), surrogate, unassigned and noncharacter code points, line and paragraph separators, Hangul fillers, and U+200D outside emoji ZWJ sequences; rejects more than 8 consecutive combining marks; and requires text to contain a visible glyph.",
  "title": "Aidan Jeon public portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "name", "web", "intro", "work", "projects", "thoughts", "webring"],
  "properties": {
    "version": { "const": 2 },
    "updated": { "oneOf": [{ "$ref": "#/$defs/shortText" }, { "type": "null" }] },
    "name": { "$ref": "#/$defs/shortText" },
    "web": { "$ref": "#/$defs/url" },
    "intro": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": { "$ref": "#/$defs/span" }
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "company", "role", "description", "url"],
        "properties": {
          "year": { "$ref": "#/$defs/year" },
          "company": { "$ref": "#/$defs/shortText" },
          "role": { "$ref": "#/$defs/shortText" },
          "description": { "$ref": "#/$defs/bodyText" },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "event", "summary", "year", "url"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "title": { "$ref": "#/$defs/shortText" },
          "event": { "oneOf": [{ "$ref": "#/$defs/shortText" }, { "type": "null" }] },
          "summary": { "$ref": "#/$defs/bodyText" },
          "year": { "$ref": "#/$defs/year" },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    },
    "thoughts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "subtitle", "year", "url", "sections"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "title": { "$ref": "#/$defs/shortText" },
          "subtitle": { "$ref": "#/$defs/bodyText" },
          "year": { "$ref": "#/$defs/year" },
          "url": { "$ref": "#/$defs/url" },
          "sections": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "items"],
              "properties": {
                "heading": { "$ref": "#/$defs/shortText" },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "url"],
                    "properties": {
                      "text": { "$ref": "#/$defs/bodyText" },
                      "url": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "webring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "home", "next"],
      "properties": {
        "previous": { "$ref": "#/$defs/url" },
        "home": { "$ref": "#/$defs/url" },
        "next": { "$ref": "#/$defs/url" }
      }
    }
  },
  "$defs": {
    "shortText": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "bodyText": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "$comment": "The exact grammar of validate_url in src/content.rs: an HTTPS host of two or more 1–63 character alphanumeric/hyphen labels (no port or userinfo) with an optional path, query or fragment of RFC 3986 characters and %XX escapes, or a mailto address with a simple local part and no query.",
      "pattern": "^(?:https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?:[/?#](?:[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=-]|%[0-9A-Fa-f]{2})*)?|mailto:[A-Za-z0-9._+-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+)$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "style", "url"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "style": { "enum": ["plain", "strong", "emphasis", "accent", "highlight"] },
        "url": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] }
      },
      "$comment": "A linked span is a focus stop and titles the link sheet, so its text must be visible.",
      "if": { "required": ["url"], "properties": { "url": { "type": "string" } } },
      "then": { "properties": { "text": { "pattern": "\\S" } } }
    }
  }
}
